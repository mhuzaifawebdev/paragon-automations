{
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_MESSAGE\" in *\"[automated]\") exit 0;; *) exit 1;; esac",
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "careers\\..*" }], "destination": "/api/careers" },
    { "source": "/job/:id", "has": [{ "type": "host", "value": "careers\\..*" }], "destination": "/api/careers?id=:id" },
    { "source": "/sitemap.xml", "has": [{ "type": "host", "value": "careers\\..*" }], "destination": "/api/careers-sitemap" },
    { "source": "/careers", "destination": "/api/careers" },
    { "source": "/careers/job/:id", "destination": "/api/careers?id=:id" },
    { "source": "/careers/sitemap.xml", "destination": "/api/careers-sitemap" }
  ]
}
