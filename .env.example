# Copy this file to .env and fill in real values. Never commit .env itself.
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# The SIP password for your extension, from my.zadarma.com -> My PBX -> Extensions
# ("generate" next to your extension). Only needed to run agent/setup_zadarma_trunk.py once.
ZADARMA_SIP_PASSWORD=
# Zadarma ACCOUNT API (different from the SIP password above) - from my.zadarma.com -> Settings -> API.
# Used only by agent/zadarma_client.py and agent/pause_monitor.py (presence/supervisor alerts),
# never for placing calls.
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
# Where agent/pause_monitor.py posts alerts - a Slack/Teams "incoming webhook" URL. Leave blank to
# only log alerts to data/alerts.csv without sending them anywhere.
ALERT_WEBHOOK_URL=
# SMTP for agent/notify_email.py - agent/pause_monitor.py emails the operator on the delayed
# extension AND config.yaml's manager_email. A Gmail account needs an "app password"
# (myaccount.google.com/apppasswords), not your normal login password. Leave SMTP_HOST blank to
# skip emailing (alerts still log to data/alerts.csv and still post to ALERT_WEBHOOK_URL above).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Scraper v2 (scraper2/): which model reads the pages. claude_api needs ANTHROPIC_API_KEY (pay per use);
# gemini needs GEMINI_API_KEY (free tier, from aistudio.google.com/apikey); rules = no AI at all (lower accuracy).
SCRAPER_PROVIDER=claude_api
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
